PUBLIC_WEB_ORIGIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable Key (pk_live_... / pk_test_...) — wird zur Build-Zeit ins Frontend
# gebacken. Pflicht fuer Embedded Checkout, sonst startet die Online-Zahlung nicht.
VITE_STRIPE_PUBLISHABLE_KEY=
# USt-Saetze (Stripe Tax Rates, beide "Im Preis enthalten"/inclusive, Land DE).
# PFLICHT — ohne sie lehnt /api/stripe/create-checkout-session jede Bestellung
# ab, statt sie ohne ausgewiesene USt durchzuwinken.
# Anlegen (empfohlen, setzt inclusive/DE/vat korrekt und gibt die IDs aus):
#   export STRIPE_SECRET_KEY=sk_live_... && node scripts/create-tax-rates.mjs
# Manuell alternativ: Dashboard -> Produktkatalog -> Steuersaetze, Berechnung
# zwingend "Im Preis enthalten":
#   7 %  Speisen   (ermaessigt) -> STRIPE_TAX_RATE_REDUCED
#   19 % Getraenke (Regelsatz)  -> STRIPE_TAX_RATE_STANDARD
# Die IDs (txr_...) sind pro Modus getrennt: Test-Keys brauchen Test-Raten.
STRIPE_TAX_RATE_REDUCED=
STRIPE_TAX_RATE_STANDARD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Resend (Bestellbestätigungs-E-Mails)
# 1. Account auf resend.com anlegen
# 2. Domain lysnoodleandrice.com verifizieren (DNS) ODER fürs Testen onboarding@resend.dev nutzen
# 3. API Key hier eintragen + From-Adresse setzen (z.B. bestellung@lysnoodleandrice.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
